FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install IPython for an interactive REPL in restricted-network shells
# (e.g. `patchpal-sandbox --shell --restrict-network`, where pip is blocked).
# Jupyter is intentionally omitted: it's a web server and not useful in a
# headless, network-restricted shell.
RUN pip install --no-cache-dir ipython

# Build arg to force cache invalidation on new releases. CI sets it to the
# PatchPal version on PyPI; local builds leave it at the default.
ARG CACHEBUST=1

# Install patchpal. In CI, pin the exact version so a stale PyPI index fails the
# build with a clear error instead of silently installing an older release.
# Local builds (CACHEBUST=1) get the latest version.
RUN if [ "$CACHEBUST" = "1" ]; then \
      pip install --no-cache-dir --upgrade patchpal; \
    else \
      pip install --no-cache-dir "patchpal==${CACHEBUST}"; \
    fi

# Set working directory
WORKDIR /workspace
